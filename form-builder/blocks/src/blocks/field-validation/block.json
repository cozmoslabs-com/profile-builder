{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "profile-builder/field-validation",
    "title": "Validation",
    "wppbFieldType": "Validation",
    "category": "profile-builder-advanced",
    "icon": "saved",
    "description": "Validation input field.",
    "attributes": {
        "id": {
            "type": "number",
            "default": 0
        },
        "field-title": {
            "type": "string",
            "default": "Validation Field"
        },
        "meta-name": {
            "type": "string",
            "default": ""
        },
        "description": {
            "type": "string",
            "default": ""
        },
        "required": {
            "type": "string",
            "default": "Yes"
        },
        "validation-possible-values": {
            "type": "string",
            "default": ""
        },
        "custom-error-message": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false,
        "reusable": false,
        "inserter": true
    },
    "textdomain": "profile-builder"
}
