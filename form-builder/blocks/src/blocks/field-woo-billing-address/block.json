        "description": { "type": "string", "default": "" },
        "woo-billing-fields": { "type": "string", "default": "" },
        "woo-billing-fields-required": { "type": "string", "default": "" },
        "woo-billing-fields-sort-order": { "type": "string", "default": "" },
        "woo-billing-fields-name": { "type": "string", "default": "" }
    },
    "supports": { "html": false, "reusable": false, "inserter": true },
    "textdomain": "profile-builder"
}
