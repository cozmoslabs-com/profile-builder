{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "profile-builder/field-default-repeat-password",
    "title": "Repeat Password",
    "wppbFieldType": "Default - Repeat Password",
    "category": "profile-builder-default",
    "icon": "lock",
    "description": "Required repeat-password confirmation field.",
    "attributes": {
        "id": {
            "type": "number",
            "default": 0
        },
        "field-title": {
            "type": "string",
            "default": "Repeat Password"
        },
        "description": {
            "type": "string",
            "default": "Type your password again."
        },
        "required": {
            "type": "string",
            "default": "Yes"
        }
    },
    "supports": {
        "html": false,
        "reusable": false,
        "inserter": true
    },
    "textdomain": "profile-builder"
}
