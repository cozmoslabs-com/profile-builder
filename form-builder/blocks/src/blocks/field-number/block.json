{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "profile-builder/field-number",
    "title": "Number",
    "wppbFieldType": "Number",
    "category": "profile-builder-standard",
    "icon": "editor-ol",
    "description": "Numeric input field.",
    "attributes": {
        "id": {
            "type": "number",
            "default": 0
        },
        "field-title": {
            "type": "string",
            "default": "Number Field"
        },
        "meta-name": {
            "type": "string",
            "default": ""
        },
        "description": {
            "type": "string",
            "default": ""
        },
        "required": {
            "type": "string",
            "default": "No"
        },
        "default-value": {
            "type": "string",
            "default": ""
        },
        "min-number-value": {
            "type": "string",
            "default": ""
        },
        "max-number-value": {
            "type": "string",
            "default": ""
        },
        "number-step-value": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false,
        "reusable": false,
        "inserter": true
    },
    "textdomain": "profile-builder"
}
